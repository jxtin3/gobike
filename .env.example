# ============================================================
# GoBike — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# Local development: set APP_ENV=local, APP_DEBUG=true,
# APP_URL=http://gobike.test and SESSION_SECURE_COOKIE=false
# ============================================================

APP_NAME=GoBike
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging: stderr shows up in Railway's deploy logs; local dev can use stack/daily
LOG_CHANNEL=stderr
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database. On Railway, set DB_URL=${{MySQL.MYSQL_URL}} instead of the separate DB_* values.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# Content-Security-Policy: enforce (recommended), report-only (console warnings only), or off
CSP_MODE=enforce
# Origin of S3/bucket storage (e.g. https://your-bucket.s3.region.amazonaws.com) for CSP img-src & media-src
MEDIA_CSP_ORIGIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Where admin uploads (news images, gallery) are stored. On Railway the container disk is
# wiped on every deploy, so either:
#  - keep MEDIA_DISK=public and attach a Railway Volume at /app/storage/app/public, or
#  - use a PUBLIC bucket (Cloudflare R2 / S3; Railway's own buckets are private): set
#    MEDIA_DISK=s3, the AWS_* values, and put the bucket origin in MEDIA_CSP_ORIGIN above,
#    otherwise the CSP blocks the images.
MEDIA_DISK=public
# Volunteer ID uploads. Private: never use a public disk. The default "local" disk is
# storage/app/private, which is wiped on every Railway deploy (a service can have only one
# Volume and it already holds the public images). On Railway use a private Storage Bucket:
# PRIVATE_DISK=s3 plus AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION=auto,
# AWS_BUCKET and AWS_ENDPOINT from the bucket's Credentials tab.
PRIVATE_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail (the site sends no email yet; "log" sends nothing)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Chatbot (Google Gemini — https://aistudio.google.com/apikey)
# if Model names get retired over time: check https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Google sign-in for the mobile app (must equal kGoogleWebClientId in Flutter)
GOOGLE_WEB_CLIENT_ID=

# Push notifications (Firebase Cloud Messaging). Project ID: rondago-684c7.
# FIREBASE_CREDENTIALS = the service-account JSON (Firebase > Project settings > Service accounts),
# pasted as-is or base64-encoded. Leave empty to turn push off.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# Mobile API login lifetime in minutes (43200 = 30 days)
SANCTUM_EXPIRATION=43200

# PayPal (https://developer.paypal.com) — use sandbox until go-live
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
# Webhook ID is REQUIRED in production, webhooks are rejected without it.
# Webhook URL: https://your-domain/webhooks/paypal (sandbox and live webhooks have different IDs)
PAYPAL_WEBHOOK_ID=
# Monthly donation plans are created automatically per currency and PayPal mode
# (saved in the paypal_donation_plans table). Optional: reuse an existing catalog product.
PAYPAL_DONATION_PRODUCT_ID=

# PayMongo (https://dashboard.paymongo.com) — GCash + online banking.
# pk_test_/sk_test_ keys for testing, pk_live_/sk_live_ once the account is activated.
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
# Webhook secret is REQUIRED in production, webhooks are rejected without it.
# Webhook URL: https://your-domain/webhooks/paymongo, event checkout_session.payment.paid.
# Test and live webhooks have different secrets (whsk_...).
PAYMONGO_WEBHOOK_SECRET=

# Donation exchange rates are fetched daily (Frankfurter / ECB). DONATION_USD_TO_PHP is only the
# fallback before the first successful fetch; DONATION_LIVE_RATES=false always uses the fallbacks.
DONATION_LIVE_RATES=true
DONATION_USD_TO_PHP=60.00