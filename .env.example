# ============================================================
# GoBike — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# Local development: set APP_ENV=local, APP_DEBUG=true,
# APP_URL=http://gobike.test and SESSION_SECURE_COOKIE=false
# ============================================================

APP_NAME=GoBike
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging: stderr is recommended for Laravel Cloud / ephemeral containers; local dev can use stack/daily
LOG_CHANNEL=stderr
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database (decided in the deployment phase: mysql or pgsql)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# Content-Security-Policy: enforce (recommended), report-only (console warnings only), or off
CSP_MODE=enforce
# Origin of S3/bucket storage (e.g. https://your-bucket.s3.region.amazonaws.com) for CSP img-src & media-src
MEDIA_CSP_ORIGIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Where admin uploads (news images, gallery) are stored. "public" is fine locally, but on
# Laravel Cloud the container disk is wiped on every deploy: attach a PUBLIC object-storage
# bucket (disk name "s3"), set MEDIA_DISK=s3 and put the bucket origin in MEDIA_CSP_ORIGIN
# above, otherwise the CSP blocks the images.
MEDIA_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail (needs a real SMTP service in production; "log" sends nothing)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Chatbot (Google Gemini — https://aistudio.google.com/apikey)
# if Model names get retired over time: check https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Google sign-in for the mobile app (must equal kGoogleWebClientId in Flutter)
GOOGLE_WEB_CLIENT_ID=

# Mobile API login lifetime in minutes (43200 = 30 days)
SANCTUM_EXPIRATION=43200

# PayPal (https://developer.paypal.com) — use sandbox until go-live
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
# Webhook ID is REQUIRED in production, webhooks are rejected without it
PAYPAL_WEBHOOK_ID=
PAYPAL_DONATION_PRODUCT_ID=
PAYPAL_DONATION_PLAN_ID=

# PayMongo (https://dashboard.paymongo.com) — GCash + online banking
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
# Webhook secret is REQUIRED in production, webhooks are rejected without it
PAYMONGO_WEBHOOK_SECRET=

# Donation settings
DONATION_USD_TO_PHP=60.00